# Moroccan Air Traffic Streaming Platform — Variables d'environnement
# Copiez ce fichier en .env et remplissez vos vraies valeurs.
# NE JAMAIS committer .env dans Git (déjà ignoré par .gitignore).

# ── OpenSky Network API (OAuth2 Client Credentials) ──────────────────────────
# Créer un compte sur https://opensky-network.org/ puis un client API.
# Laisser vide pour l'accès anonyme (quota réduit : 400 credits/jour).
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
OPENSKY_TOKEN_URL=https://auth.opensky-network.org/auth/realms/opensky-network/protocol/openid-connect/token

# ── Paramètres producteur ─────────────────────────────────────────────────────
# Intervalle de polling en secondes (anonyme: min 10s, authentifié: min 5s)
PRODUCER_POLL_INTERVAL_S=15
# Utiliser les données synthétiques au lieu de l'API réelle (true/false)
PRODUCER_SYNTHETIC_MODE=true
# Niveau de log
PRODUCER_LOG_LEVEL=INFO

# ── Apache Kafka (Confluent Platform 7.6.1) ───────────────────────────────────
# En Docker : kafka:9092 (réseau interne)
# Depuis Windows (hôte) : localhost:19092
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_FLIGHTS=flights.raw
KAFKA_TOPIC_DLQ=flights.dlq

# ── Spark ─────────────────────────────────────────────────────────────────────
SPARK_MASTER=local[*]
DELTA_LAKE_PATH=/data/lake

# ── PostgreSQL Data Warehouse (dbt Gold — séparé d'Airflow) ──────────────────
# Port 5433 exposé sur l'hôte Windows (5432 est réservé à Airflow)
WAREHOUSE_HOST=warehouse
WAREHOUSE_PORT=5432
WAREHOUSE_DB=flights_dw
WAREHOUSE_USER=flights_user
WAREHOUSE_PASSWORD=CHANGE_ME_strong_password_here

# ── Airflow ───────────────────────────────────────────────────────────────────
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow@postgres:5432/airflow
# Générer avec : python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
AIRFLOW__CORE__FERNET_KEY=CHANGE_ME_generate_with_python
AIRFLOW__CORE__LOAD_EXAMPLES=false
# Générer avec : python -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW__WEBSERVER__SECRET_KEY=CHANGE_ME_generate_with_python

# ── Open-Meteo (pas de clé API requise — service gratuit) ────────────────────
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# ── Snowflake (optionnel — cible dbt cloud) ───────────────────────────────────
# Laisser vide si vous n'utilisez pas Snowflake.
SNOWFLAKE_ACCOUNT=your_account.region
SNOWFLAKE_USER=your_snowflake_user
SNOWFLAKE_PASSWORD=CHANGE_ME
SNOWFLAKE_ROLE=TRANSFORMER
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=MOROCCAN_AIR_TRAFFIC
SNOWFLAKE_SCHEMA=GOLD
