# ─────────────────────────────────────────────────────────────
# Moroccan Air Traffic Streaming Platform — Environment Variables
# Copy to .env and fill in your values. NEVER commit .env to Git.
# ─────────────────────────────────────────────────────────────

# ── OpenSky Network API (OAuth2 Client Credentials) ──────────
# Register at https://opensky-network.org/ and create an API client
# to get client_id and client_secret. Leave empty for anonymous access
# (lower rate limits: 400 credits/day vs 4000 authenticated).
# NOTE: Basic auth was retired March 2026. OAuth2 is now mandatory.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
OPENSKY_TOKEN_URL=https://auth.opensky-network.org/auth/realms/opensky-network/protocol/openid-connect/token

# ── Producer settings ────────────────────────────────────────
# Polling interval in seconds (OpenSky anonymous: min 10s, authenticated: min 5s)
PRODUCER_POLL_INTERVAL_S=15
# Use synthetic data instead of real API (true/false)
PRODUCER_SYNTHETIC_MODE=true
# Log level (DEBUG, INFO, WARNING, ERROR)
PRODUCER_LOG_LEVEL=INFO

# ── Redpanda / Kafka ────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=redpanda:9092
KAFKA_TOPIC_FLIGHTS=flights.raw
KAFKA_TOPIC_DLQ=flights.dlq

# ── Spark ────────────────────────────────────────────────────
SPARK_MASTER=local[*]
DELTA_LAKE_PATH=/data/lake

# ── DuckDB / dbt ────────────────────────────────────────────
DUCKDB_PATH=/data/analytics.duckdb

# ── Airflow ──────────────────────────────────────────────────
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow@postgres:5432/airflow
AIRFLOW__CORE__FERNET_KEY=CHANGE_ME_GENERATE_WITH_python_-c_"from_cryptography.fernet_import_Fernet;print(Fernet.generate_key().decode())"
AIRFLOW__CORE__LOAD_EXAMPLES=false
AIRFLOW__WEBSERVER__SECRET_KEY=CHANGE_ME

# ── Open-Meteo ───────────────────────────────────────────────
# Open-Meteo is free and requires no API key.
# Base URL override (useful for testing with a mock server)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
